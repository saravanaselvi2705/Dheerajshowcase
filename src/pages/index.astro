---
import '../styles/global.css';
import ShowcaseHero from '../components/ShowcaseHero.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dheeraj C — Senior Video Editor &amp; Content Delivery Manager</title>
    <meta
      name="description"
      content="High-retention video editing, commercial spots, social reels, motion graphics, and end-to-end content delivery pipelines by Dheeraj C."
    />
    <meta name="theme-color" content="#0C0D10" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230C0D10'/%3E%3Crect x='6' y='6' width='52' height='52' rx='10' fill='none' stroke='%23590907' stroke-width='3'/%3E%3Ccircle cx='18' cy='18' r='4' fill='%23E8D2B5'/%3E%3Ctext x='32' y='44' text-anchor='middle' font-family='Georgia, serif' font-weight='700' font-size='21' fill='%23E8D2B5'%3EDC%3C/text%3E%3C/svg%3E"
    />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://drive.google.com" crossorigin />
    <link
      href="https://api.fontshare.com/v2/css?f[]=clash-display@500,600,700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Jost:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#0C0D10] text-[#E8D2B5] antialiased">
    <main>
      <ShowcaseHero />
    </main>
  </body>
</html>
