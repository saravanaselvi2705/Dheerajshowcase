---
import '../styles/global.css';
import ScreeningRoom from '../components/ScreeningRoom.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DHEERAJ C — Post-Production Screening Room</title>
    <meta
      name="description"
      content="Digital Screening Room for Dheeraj C — Commercials, Short-Form Reels, and Documentary / Long-Form post-production showcase."
    />
    <meta name="theme-color" content="#141517" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700&family=JetBrains+Mono:wght@400;500;600&family=Jost:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#141517] text-[#E8D2B5] antialiased">
    <ScreeningRoom />
  </body>
